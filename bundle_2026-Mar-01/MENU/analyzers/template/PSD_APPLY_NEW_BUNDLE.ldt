BEGIN DESC_FLEX "FND" "$SRS$.PSD_APPLY_NEW_BUNDLE"
  OWNER = "Oracle Proactive Support"
  LAST_UPDATE_DATE = "2018/04/18 10:15:56"
  TABLE_APPLICATION_SHORT_NAME = "FND"
  APPLICATION_TABLE_NAME = "FND_SRS_MASTER"
  CONTEXT_COLUMN_NAME = "STRUCTURE_COLUMN"
  CONTEXT_REQUIRED_FLAG = "N"
  CONTEXT_USER_OVERRIDE_FLAG = "N"
  CONCATENATED_SEGMENT_DELIMITER = ":"
  FREEZE_FLEX_DEFINITION_FLAG = "Y"
  PROTECTED_FLAG = "S"
  CONTEXT_OVERRIDE_VALUE_SET_NAM = ""
  TITLE = "$SRS$.PSD_APPLY_NEW_BUNDLE"
  FORM_CONTEXT_PROMPT = "Context Value"
  DESCRIPTION = "Perl Program to Install Analyzers During AutoUpdate"

  BEGIN DFF_CONTEXT "Global Data Elements"
    OWNER = "Oracle Proactive Support"
    LAST_UPDATE_DATE = "2018/02/27 00:00:00"
    ENABLED_FLAG = "Y"
    GLOBAL_FLAG = "Y"
    DESCRIPTIVE_FLEX_CONTEXT_NAME = "Global Data Elements"
  
    BEGIN DFF_SEGMENT "FAMILES" "ATTRIBUTE1"
      OWNER = "Oracle Proactive Support"
      LAST_UPDATE_DATE = "2018/04/18 10:15:25"
      COLUMN_SEQ_NUM = "1"
      ENABLED_FLAG = "Y"
      DISPLAY_FLAG = "Y"
      REQUIRED_FLAG = "Y"
      SECURITY_ENABLED_FLAG = "N"
      FLEX_VALUE_SET_NAME = "50 chars"
      DISPLAY_SIZE = "50"
      MAXIMUM_DESCRIPTION_LEN = "50"
      CONCATENATION_DESCRIPTION_LEN = "25"
      DEFAULT_TYPE = "C"
      DEFAULT_VALUE = "ALL"
      FORM_LEFT_PROMPT = "Analyzer Families"
      FORM_ABOVE_PROMPT = "Analyzer Families"
      DESCRIPTION =
 "Analyzer Families To Load (ie, \"ATG\", \"HCM\", \"CRM\", \"FIN\", \"MFG\", \"ALL\")"
    END DFF_SEGMENT
    
    BEGIN DFF_SEGMENT "BUNDLE_LOCATION" "ATTRIBUTE2"
      OWNER = "Oracle Proactive Support"
      LAST_UPDATE_DATE = "2018/04/18 10:15:25"
      COLUMN_SEQ_NUM = "2"
      ENABLED_FLAG = "Y"
      DISPLAY_FLAG = "Y"
      REQUIRED_FLAG = "Y"
      SECURITY_ENABLED_FLAG = "N"
      FLEX_VALUE_SET_NAME = "150 Characters Optional"
      DISPLAY_SIZE = "50"
      MAXIMUM_DESCRIPTION_LEN = "50"
      CONCATENATION_DESCRIPTION_LEN = "25"
      DEFAULT_TYPE = "C"
      DEFAULT_VALUE = "/tmp"
      FORM_LEFT_PROMPT = "BUNDLE_LOCATION"
      FORM_ABOVE_PROMPT = "BUNDLE_LOCATION"
      DESCRIPTION = "The location you specified for the bundle"
    END DFF_SEGMENT
    
  END DFF_CONTEXT
  
END DESC_FLEX

BEGIN PROGRAM "PSD_APPLY_NEW_BUNDLE" "FND"
  OWNER = "Oracle Proactive Support"
  LAST_UPDATE_DATE = "2018/04/18"
  USER_CONCURRENT_PROGRAM_NAME = "PSD_APPLY_NEW_BUNDLE"
  EXEC = "PSD_APPLY_NEW_BUNDLE_EXE" "FND"
  EXECUTION_METHOD_CODE = "E"
  ARGUMENT_METHOD_CODE = "4"
  QUEUE_CONTROL_FLAG = "N"
  QUEUE_METHOD_CODE = "I"
  REQUEST_SET_FLAG = "N"
  ENABLED_FLAG = "Y"
  PRINT_FLAG = "Y"
  RUN_ALONE_FLAG = "N"
  SRS_FLAG = "Y"
  DESCRIPTION = "Perl Program to Install Analyzers During AutoUpdate"
  SAVE_OUTPUT_FLAG = "Y"
  REQUIRED_STYLE = "N"
  OUTPUT_FILE_TYPE = "TEXT"
  RESTART = "Y"
  NLS_COMPLIANT = "Y"
  MLS_EXEC = "" ""
  ENABLE_TIME_STATISTICS = "N"
  SRS_FLEX = "FND" "$SRS$.PSD_APPLY_NEW_BUNDLE"
  AUTO_ANNOTATION =
 "/**\n\
  * @param FAMILES Analyzer Families To Load (ie, \"ATG\", \"HCM\", \"CRM\", \"FIN\", \"MFG\", \"ALL\")\n\
  * @rep:paraminfo {@rep:type 50 chars} {@rep:displayed Y} {@rep:required}\n\
  * @param BUNDLE_LOCATION The location you specified for the bundle\n\
  * @rep:paraminfo {@rep:type 150 Characters Optional} {@rep:displayed Y} {@rep:required}\n\
  */"

END PROGRAM
