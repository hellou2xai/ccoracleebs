BEGIN VALUE_SET "SLASTPANLZ_p_event_class"
  OWNER = "ORACLE"
  LAST_UPDATE_DATE = "2025/12/08 13:48:01"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "500"
  NUMBER_PRECISION = "0"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Event Class"

  

  BEGIN VSET_TABLE
    OWNER = "ORACLE"
    LAST_UPDATE_DATE = "2025/12/08 13:48:01"
    APPLICATION_TABLE_NAME =
 " XLA_EVENT_CLASSES_FVL"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "EVENT_CLASS_NAME"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "500"
    ID_COLUMN_NAME = "EVENT_CLASS_CODE"
    ID_COLUMN_TYPE = "V"
    ID_COLUMN_SIZE = "500"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "application_id = :$FLEX$.p_application_id
and event_class_code in
    (select distinct ec.event_class_code 
    from   xla_aad_line_defn_assgns lda, 
               xla_event_classes_fvl ec, 
               xla_event_types_tl et
    where lda.application_id = :$FLEX$.p_application_id
    AND    ec.enabled_flag = 'Y'
    AND    lda.product_rule_code = :$FLEX$.p_aad
    AND    lda.amb_context_code = :$FLEX$.p_context
    AND    ec.application_id = lda.application_id
    AND    ec.event_class_code = lda.event_class_code
    AND    et.event_type_code = lda.event_type_code
    AND    et.application_id = lda.application_id
    AND    et.language = USERENV('LANG')
    AND    et.event_class_code = ec.event_class_code)"
    ADDITIONAL_QUICKPICK_COLUMNS = ""
  END VSET_TABLE



  END VALUE_SET
  



