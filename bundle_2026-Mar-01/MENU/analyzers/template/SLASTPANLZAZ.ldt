    ID_COLUMN_NAME = "AAD.PRODUCT_RULE_CODE"
    ID_COLUMN_TYPE = "V"
    ID_COLUMN_SIZE = "500"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE =
 "AAD.application_id = :$FLEX$.p_application_id
and     SLAM.ACCOUNTING_METHOD_CODE = :$FLEX$.p_slam
and     SLAM.PRODUCT_RULE_CODE = AAD.PRODUCT_RULE_CODE
ORDER BY SLAM.PRODUCT_RULE_NAME ASC"
