BEGIN PROGRAM "OTL_ANALYZE" "HXT"
  OWNER = "ORACLE"
  LAST_UPDATE_DATE = "2013/10/28"
  USER_CONCURRENT_PROGRAM_NAME = "OTL Analyzer"
  EXEC = "OTL_Analyzer_Sql" "HXT"
  EXECUTION_METHOD_CODE = "I"
  ARGUMENT_METHOD_CODE = "4"
  QUEUE_CONTROL_FLAG = "N"
  QUEUE_METHOD_CODE = "I"
  REQUEST_SET_FLAG = "N"
  ENABLED_FLAG = "Y"
  PRINT_FLAG = "Y"
  RUN_ALONE_FLAG = "N"
  SRS_FLAG = "Y"
  DESCRIPTION = "Oracle Time and Labor Analyzer"
  SAVE_OUTPUT_FLAG = "Y"
  REQUIRED_STYLE = "N"
  OUTPUT_FILE_TYPE = "HTML"
  RESTART = "Y"
  NLS_COMPLIANT = "Y"
  MLS_EXEC = "" ""
  ENABLE_TIME_STATISTICS = "N"
  SRS_FLEX = "HXT" "$SRS$.OTL_ANALYZE"
  AUTO_ANNOTATION =
 "/**\n\
  * @param OTL%_Technical%_Info Output OTL Technical Information (versions, patching, performance)?\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param Setup%_Analyzer Output Setup Analyzer?\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param HXC%_Timecard Output HXC (Self Service / Timekeeper) Timecard?\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param Person Person (use % to search for ID, Full Name or Employee Number)\n\
  * @rep:paraminfo {@rep:type POANALZ} {@rep:displayed Y}\n\
  * @param Start%_date HXC Timecard Start Date\n\
  * @rep:paraminfo {@rep:type Start_Date_OTL_Analyzer} {@rep:displayed Y}\n\
  * @param Employee%_Preferences Output Timecard Owner's Preferences?\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param HXT(OTLR)%_Timecard Output HXT(OTLR) Timecard? (Choose Y only if OTLR is enabled)\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param TIM%_ID HXT Timecard (use % to search for ID or Start Date) First choose Person!\n\
  * @rep:paraminfo {@rep:type Tim_ID_OTL_Analyzer} {@rep:displayed Y}\n\
  * @param Batch Output Specific Batch?\n\
  * @rep:paraminfo {@rep:type Fnd Stats Yes_No} {@rep:displayed Y}\n\
  * @param Batch%_ID Batch (use % to search for ID, Batch Number or Batch Reference)\n\
  * @rep:paraminfo {@rep:type Batch_Id_OTL_Analyzer} {@rep:displayed Y}\n\
  */"


END PROGRAM

