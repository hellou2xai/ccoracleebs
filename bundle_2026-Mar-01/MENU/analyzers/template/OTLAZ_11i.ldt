    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE = "where h.assignment_id in\n\
  (select assignment_id\n\
   from per_all_assignments_f\n\
   where person_id = :$FLEX$.POANALZ\n\
   and primary_flag = 'Y' and assignment_type IN ('E', 'C'))\n\
  and h.date_worked = (select min(date_worked) from HXT_SUM_HOURS_WORKED_F where tim_id = h.tim_id)\n\
  order by h.date_worked desc"
  END VSET_TABLE





END VALUE_SET

