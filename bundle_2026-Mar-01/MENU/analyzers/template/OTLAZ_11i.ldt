  BEGIN VSET_TABLE
    OWNER = "ORACLE"
    LAST_UPDATE_DATE = "2014/01/14 10:16:38"
    TABLE_APPLICATION_SHORT_NAME = "HXT"
    APPLICATION_TABLE_NAME = "HXT_SUM_HOURS_WORKED_F h"
    SUMMARY_ALLOWED_FLAG = "N"
