BEGIN VALUE_SET "POANALZ"
  OWNER = "ORACLE"
  LAST_UPDATE_DATE = "2013/12/17 13:49:18"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "280"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Persons for OTL Analyzer"


  BEGIN VSET_TABLE
    OWNER = "ORACLE"
    LAST_UPDATE_DATE = "2013/12/17 13:49:11"
    TABLE_APPLICATION_SHORT_NAME = "PER"
    APPLICATION_TABLE_NAME = "PER_ALL_PEOPLE_F peo"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME =
 "PEO.PERSON_ID||' '||PEO.FULL_NAME||' '||PEO.EMPLOYEE_NUMBER"
    VALUE_COLUMN_TYPE = "C"
    VALUE_COLUMN_SIZE = "280"
    ID_COLUMN_NAME = "PEO.PERSON_ID"
    ID_COLUMN_TYPE = "N"
    ID_COLUMN_SIZE = "22"
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
        ADDITIONAL_WHERE_CLAUSE =
 "peo.effective_end_date =
    (select max(peo1.effective_end_date)
    from per_all_people_f peo1
    where peo1.person_id = peo.person_id)
and 
(exists (select 'Y'
     from hxc_time_building_blocks htbb
     where peo.person_id = htbb.resource_id
     and htbb.resource_type = 'PERSON')
or exists (select 'Y'
     from hxc_time_building_blocks_ar htar
     where peo.person_id = htar.resource_id
     and htar.resource_type = 'PERSON')  
or exists (select 'Y'
     from HXT_TIMECARDS_F hxt
     where peo.person_id = hxt.FOR_PERSON_ID)      
     )
ORDER BY peo.full_name"
  END VSET_TABLE


END VALUE_SET

BEGIN VALUE_SET "Start_Date_OTL_Analyzer"
  OWNER = "ORACLE"
  LAST_UPDATE_DATE = "2013/12/11 13:43:09"
  VALIDATION_TYPE = "F"
  PROTECTED_FLAG = "N"
  SECURITY_ENABLED_FLAG = "N"
  LONGLIST_FLAG = "N"
  FORMAT_TYPE = "C"
  MAXIMUM_SIZE = "11"
  ALPHANUMERIC_ALLOWED_FLAG = "Y"
  UPPERCASE_ONLY_FLAG = "N"
  NUMERIC_MODE_ENABLED_FLAG = "N"
  DESCRIPTION = "Start Date for OTL Analyzer"

 BEGIN VSET_TABLE
    OWNER = "ORACLE"
    LAST_UPDATE_DATE = "2018/08/31 09:59:27"
    APPLICATION_TABLE_NAME =
 "(SELECT START_TIME FROM HXC_TIME_BUILDING_BLOCKS WHERE SCOPE='TIMECARD' AND RESOURCE_ID=:$FLEX$.POANALZ UNION SELECT START_TIME FROM HXC_TIME_BUILDING_BLOCKS_AR WHERE SCOPE='TIMECARD' AND RESOURCE_ID=:$FLEX$.POANALZ)"
    SUMMARY_ALLOWED_FLAG = "N"
    VALUE_COLUMN_NAME = "to_char(start_time,'DD-MON-YYYY')"
    VALUE_COLUMN_TYPE = "V"
    VALUE_COLUMN_SIZE = "30"
    ID_COLUMN_NAME = ""
    ID_COLUMN_TYPE = ""
    ID_COLUMN_SIZE = ""    
    ENABLED_COLUMN_NAME = "'Y'"
    COMPILED_ATTRIBUTE_COLUMN_NAME = "NULL"
    HIERARCHY_LEVEL_COLUMN_NAME = "NULL"
    START_DATE_COLUMN_NAME = "to_date(null)"
    END_DATE_COLUMN_NAME = "to_date(null)"
    SUMMARY_COLUMN_NAME = "'N'"
    ADDITIONAL_WHERE_CLAUSE = "ORDER BY start_time DESC"
    ADDITIONAL_QUICKPICK_COLUMNS = ""
  END VSET_TABLE
  
  
 


END VALUE_SET

